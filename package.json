{
  "name": "@aihu-plugin/kindly-note",
  "version": "0.2.5",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/element.js",
    "./dist/markdown-element.js"
  ],
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:pack": "node scripts/verify-pack.mjs",
    "consumer:smoke": "node scripts/consumer-smoke.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@kindly-note/core": "^0.2.0",
    "@kindly-note/emitters-html": "^0.1.0",
    "@kindly-note/loader-dynamic-import": "^0.1.0",
    "@kindly-note/render-markdown": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@kindly-note/core": {
      "optional": true
    },
    "@kindly-note/emitters-html": {
      "optional": true
    },
    "@kindly-note/loader-dynamic-import": {
      "optional": true
    },
    "@kindly-note/render-markdown": {
      "optional": true
    }
  },
  "dependencies": {
    "@aihu/signals": "^0.5.1"
  },
  "devDependencies": {
    "@aihu/plugin": "^0.1.1",
    "@aihu/server": "^0.6.0",
    "@types/node": "^20.16.5",
    "@kindly-note/core": "^0.2.0",
    "@kindly-note/emitters-html": "^0.1.0",
    "@kindly-note/loader-dynamic-import": "^0.1.0",
    "@kindly-note/lang-json": "^0.1.0",
    "@kindly-note/lang-typescript": "^0.1.0",
    "@kindly-note/render-markdown": "^0.1.0",
    "jsdom": "^25.0.1",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  },
  "description": "Runtime syntax highlighting + markdown rendering for aihu \u2014 <aihu-code>/<aihu-markdown> custom elements + signal-aware highlight()/renderMarkdown() helpers, powered by published @kindly-note/* packages with lazy loading.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-plugin-kindly-note.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-plugin-kindly-note#readme",
  "bugs": "https://github.com/aihu-project/aihu-plugin-kindly-note/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.5.1"
  }
}
